# Required for the platform knowledge index.
OPENROUTER_API_KEY=

# Required for the local microphone test. Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=

MISTRAL_LLM_MODEL=mistral-small-latest
MISTRAL_STT_MODEL=voxtral-mini-latest
MISTRAL_TTS_MODEL=voxtral-mini-tts-latest
MISTRAL_VOICE=en_paul_neutral
# Voxtral TTS officially supports English, French, German, Spanish, Dutch,
# Portuguese, Italian, Hindi and Arabic. Russian input is supported by STT.
ASSISTANT_LANGUAGE=auto

# Optional: only for dev/start with a LiveKit server or LiveKit Cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
